---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import LegalEnhancer from "../components/LegalEnhancer.astro";
import DataDeletionContent from "../components/DataDeletionContent.astro";
import { buildMetaMap, supportPageContent, sharedContent } from "../i18n/content";
import { defaultLocale } from "../i18n/config";
import "../styles/global.css";

const locale = defaultLocale;
const pageCopy = supportPageContent[locale];
const metaMap = buildMetaMap(supportPageContent);
const runtime = {
	defaultLocale,
	content: supportPageContent,
	sharedContent,
};
---

<BaseLayout
	title={pageCopy.meta.title}
	description={pageCopy.meta.description}
	pathname="/soporte"
	localizedMeta={metaMap}
>
		<main class="legal-page" id="contenido">
			<div class="container">
				<a class="btn btn-small back-link" href="/" data-back-link>{sharedContent[locale].backToHome}</a>
			</div>
			<div class="container legal-layout">
				<article class="legal">
					<DataDeletionContent html={pageCopy.body} />
				</article>
				<nav class="legal-toc" data-legal-toc hidden>
					<p data-legal-toc-title>En esta página</p>
					<ol></ol>
				</nav>
			</div>
		</main>

		<Footer />
	<script type="application/json" id="support-i18n" set:html={JSON.stringify(runtime)}></script>
	<script is:inline>
		(() => {
			const payload = document.getElementById("support-i18n");

			if (!payload?.textContent) {
				return;
			}

			const runtime = JSON.parse(payload.textContent);
			const contentNode = document.querySelector("[data-legal-content]");
			const backLink = document.querySelector("[data-back-link]");

			const render = (locale) => {
				const copy = runtime.content[locale] ?? runtime.content[runtime.defaultLocale];
				const shared = runtime.sharedContent[locale] ?? runtime.sharedContent[runtime.defaultLocale];

				if (contentNode) contentNode.innerHTML = copy.body;
				if (backLink) backLink.textContent = shared.backToHome;
			};

			window.addEventListener("canelita:localechange", (event) => render(event.detail.locale));
			render(document.documentElement.dataset.locale ?? runtime.defaultLocale);
		})();
	</script>
	<LegalEnhancer />
</BaseLayout>